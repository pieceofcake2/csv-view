{
    "name": "pieceofcake2/csv-view",
    "description": "A CSV View class for CakePHP 2.x",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "csv", "view", "export"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "friendsofcake/cakephp-csvview": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "CsvView"
    }
}
